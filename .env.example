# Model folosit pentru extragerea parametrilor din liniile de deviz.
# Doar structured outputs, temperature 0. Nu calculeaza niciodata preturi.
OPENAI_API_KEY=sk-...
# gpt-4o are doar 90.000 tokeni/zi; gpt-4.1 are 900.000, la aceeasi calitate.
# Familia gpt-5 respinge temperature 0, deci nu se poate folosi aici.
OPENAI_MODEL=gpt-4.1

# Prag sub care o linie extrasa merge obligatoriu la validare umana (0..1)
IZOREP_CONFIDENCE_THRESHOLD=0.85

# Debitul catre model. Sunt DOUA limite diferite, care se rezolva in directii
# opuse:
#   pe minut (TPM/RPM) -> IZOREP_CONCURENTA mai mic
#   pe zi   (TPD)      -> IZOREP_LOT mai MARE (mai putine apeluri, deci mai
#                         putine retrimiteri ale system prompt-ului)
# Alternativa fara model: npm run import -- <fisier> --fara-model
# IZOREP_LOT=25
# IZOREP_CONCURENTA=4

# Baza de date. Implicit e cea din docker-compose.yml, deci de obicei nu
# trebuie setata local.
#
# Aplicatia se conecteaza cu izorep_app, NU cu proprietarul schemei:
# superuserii ocolesc row-level security, deci cu rolul gresit izolarea
# intre tenanti nu ar functiona si testele ar trece fals.
# DATABASE_URL=postgres://izorep_app:izorep_app@localhost:5433/izorep
