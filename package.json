{
  "name": "izorep",
  "version": "0.1.0",
  "private": true,
  "description": "ERP izolatii termice - motor de preturi si import oferte clienti",
  "type": "module",
  "scripts": {
    "start": "npm run db:up && npm run db:migrate && npm run dev",
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "tsx src/db/migreaza.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 4 && npm run db:migrate && npm run db:seed",
    "db:generate": "drizzle-kit generate",
    "db:psql": "docker compose exec db psql -U izorep -d izorep",
    "import": "tsx src/import/cli.ts",
    "price": "tsx src/pricing/cli.ts",
    "compara": "tsx scripts/compara-modele.ts",
    "golden": "tsx scripts/golden.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "openai": "^4.77.0",
    "postgres": "^3.4.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  }
}
